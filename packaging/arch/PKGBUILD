# Maintainer: lcsssilva
pkgname=hubless-git
pkgver=r0.0000000
pkgrel=1
pkgdesc='Native configurator for Logitech G peripherals (unofficial)'
arch=('x86_64')
url='https://github.com/lcsssilva/hubless'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'libpipewire' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'git' 'gtest' 'ninja')
checkdepends=('python')
optdepends=('headsetcontrol: G733 battery, sidetone and lights'
            'libratbag: read G703 settings via ratbagd'
            'pipewire: host equalizer and microphone noise suppression'
            'noise-suppression-for-voice: microphone noise suppression (RNNoise)')
provides=('hubless')
conflicts=('hubless')
source=('hubless::git+https://github.com/lcsssilva/hubless.git')
sha256sums=('SKIP')

pkgver() {
  cd hubless
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cmake -B build -S hubless -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DGHUB_BUILD_TESTS=ON
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
